MimeType=audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-ogg;audio/vorbis;audio/x-vorbis;audio/x-vorbis+ogg;audio/wav;audio/x-wav;audio/vnd.wave;audio/aac;audio/x-aac;audio/mp4;audio/m4a;audio/x-m4a;audio/x-m4b;audio/x-mpegurl;audio/mpegurl;
